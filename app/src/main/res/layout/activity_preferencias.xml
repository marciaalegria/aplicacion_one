<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de la tercera pantalla: PreferenciasActivity (Bloque 3) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".PreferenciasActivity">

    <!-- 1. TextView de título centrado -->
    <TextView
        android:id="@+id/txtTituloPreferencias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/titulo_preferencias"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. LinearLayout vertical para agrupar las opciones de configuración -->
    <LinearLayout
        android:id="@+id/layoutOpciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloPreferencias">

        <!-- 3. MaterialSwitch (swNotificaciones) con el texto "Recibir notificaciones" -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swNotificaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sw_notificaciones"
            android:textSize="16sp"
            android:textOn="ON"
            android:textOff="OFF" />

        <!-- Etiqueta para el selector de idioma -->
        <TextView
            android:id="@+id/txtLabelIdioma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_idioma"
            android:textColor="#424242"
            android:textSize="16sp" />

        <!-- 4. Spinner (spIdioma) para seleccionar el idioma (@array/idiomas) -->
        <Spinner
            android:id="@+id/spIdioma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:spinnerMode="dropdown" />

    </LinearLayout>

    <!-- Botón para guardar o volver -->
    <Button
        android:id="@+id/btnVolver"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:onClick="onVolverClick"
        android:text="Guardar y Regresar"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutOpciones" />

</androidx.constraintlayout.widget.ConstraintLayout>
